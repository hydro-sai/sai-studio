@article{zhang2026floodlandslide,
  selected = {true},
  title = {Spatiotemporal Patterns and Machine-Learning Attribution of Rainstorm-Induced Flood and Landslide Hazards in Small and Medium-Sized Catchments of China, 2015–2025},
  author = {Ke Zhang and Saisai Yin and Hongjun Bao and Hengde Zhang},
  year = {2026},
  journal = {Water Resources Protection},
  pages = {1–15},
  urldate = {2026-08-20},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CAPJ&dbname=&filename=},
  abstract = {To address the challenges of spatial heterogeneity in rainfall-induced flood and landslide disasters in small and medium-sized watersheds across China and difficulty of quantifying nonlinear disaster-causing mechanisms, this study proposes a coupled Geodetector and Light Gradient Boosting Machine (LightGBM) model (Geo-LGBM) for identification of hazard factors. The model takes the seven major geographical divisions as spatial constraints, uses Geodetector to determine the modeling boundaries, and employs LightGBM to analyze the nonlinear contributions of multiple factors to disaster occurrence. Validation results from 2015 to 2025 show that the model achieves AUC values exceeding 0.9 in each division, indicating good robustness. Spatiotemporal analysis reveals that flood frequency increases with fluctuations and is concentrated from May to August, whereas landslide frequency fluctuates more drastically and its attenuation lags significantly behind that of floods. Floods are clustered in East, South, Central, and Southwest China, while landslides are concentrated in Southwest, Central, and South China. Hazard factor contribution analysis shows marked spatiotemporal heterogeneity: floods follow hazard-bearing-body-driven, meteorologically driven, and hazard-bearing-body–meteorological coupled patterns, whereas landslides follow hazard-bearing-body-driven, topographic–cumulative rainfall-driven, and hazard-bearing-body–extreme rainfall coupled patterns.},
  description = {We propose a Geo-LGBM model that couples Geodetector and Light Gradient Boosting Machine (LightGBM) for quantitative identification of hazard factors.},
  note = {Status: advance online publication. Funded by the Major Science and Technology Project of Qinghai Province (2024-SF-A1), the Jiangsu Provincial Special Fund for the "Belt and Road" Innovation Cooperation Programme (BZ2024035), and the Guangxi Major Special Programme (Gui Ke JF2503980041).},
  keywords = {flood disaster; landslide disaster; spatiotemporal heterogeneity; hazard factor analysis; Geo-LGBM model}
}
