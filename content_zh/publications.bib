@article{zhang2026floodlandslide,
  selected = {true},
  title = {2015—2025年中国降雨型中小流域洪水与滑坡灾害的时空分布及致灾因子机器学习分析},
  author = {{张珂} and {尹赛赛} and {包红军} and {张恒德}},
  year = {2026},
  journal = {水资源保护},
  pages = {1–15},
  urldate = {2026-08-20},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CAPJ&dbname=&filename=},
  abstract = {针对全国降雨型中小流域洪水与滑坡灾害空间异质性强、多因子非线性致灾机制难以量化的难题，提出一种耦合地理探测器与轻量级梯度提升机（LightGBM）的致灾因子量化识别模型（Geo-LGBM）。模型以七大地理分区为空间约束，利用地理探测器确定建模边界，基于LightGBM解析多因子对灾害发生的非线性贡献。2015—2025年的验证结果显示，模型在各分区AUC值均高于0.9，稳健性表现良好。时空分析表明，洪水频次波动上升且集中于5—8月，滑坡频次波动剧烈且衰减过程较洪水明显滞后；洪水聚集在华东、华南、华中及西南地区，滑坡聚集在西南、华中、华南地区。对各分区致灾因子贡献度的解析表明，致灾机制呈现显著空间分异：洪水分承灾体、气象及承灾体-气象驱动模式，滑坡分承灾体、地形-累积降雨及承灾体-极端降雨驱动模式。},
  description = {提出一种耦合地理探测器与轻量级梯度提升机（LightGBM）的致灾因子量化识别模型（Geo-LGBM）},
  note = {状态：网络首发。基金项目：青海省重大科技专项（2024-SF-A1）；江苏省科技计划专项资金“一带一路”创新合作项目（BZ2024035）；广西重大专项计划（桂科JF2503980041）。},
  keywords = {洪水灾害, 滑坡灾害, 时空分异, 致灾因子分析, Geo-LGBM模型}
}
