@article{zhang2026floodlandslide,
  selected = {true},
  title = {Spatiotemporal Patterns and Machine-Learning Attribution of Rainstorm-Induced Flood and Landslide Hazards in Small and Medium-Sized Catchments of China, 2015–2025},
  author = {Ke Zhang and Saisai Yin and Hongjun Bao and Hengde Zhang},
  year = {2026},
  journal = {Water Resources Protection},
  pages = {1–15},
  urldate = {2026-08-20},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CAPJ&dbname=&filename=},
  abstract = {Rainstorm-induced floods and landslides in small and medium-sized catchments of China show strong spatial heterogeneity, and their multi-factor, non-linear failure mechanisms remain difficult to quantify. We propose Geo-LGBM, a hazard-factor identification framework that couples a geographical detector with LightGBM. Taking the seven geographical regions of China as spatial constraints, the geographical detector defines the modelling boundaries and LightGBM resolves the non-linear contribution of individual factors to hazard occurrence. Validation over 2015–2025 yields AUC values above 0.9 in every region, indicating good robustness. The spatiotemporal analysis shows that flood frequency fluctuates upward and concentrates in May–August, whereas landslide frequency fluctuates sharply and decays noticeably later than floods; floods cluster in East, South, Central and Southwest China, while landslides cluster in Southwest, Central and South China. Regional attribution reveals pronounced spatial differentiation in the driving mechanisms: floods are driven by hazard-bearing bodies, by meteorological factors, and by their combination, whereas landslides are driven by hazard-bearing bodies, by terrain–cumulative rainfall, and by hazard-bearing bodies–extreme rainfall.},
  description = {We propose Geo-LGBM, a framework that couples a geographical detector with LightGBM to quantify the multi-factor, non-linear drivers of rainstorm-induced floods and landslides across China.},
  note = {Status: advance online publication. Funded by the Major Science and Technology Project of Qinghai Province (2024-SF-A1), the Jiangsu Provincial Special Fund for the "Belt and Road" Innovation Cooperation Programme (BZ2024035), and the Guangxi Major Special Programme (Gui Ke JF2503980041).},
  keywords = {flood hazard, landslide hazard, spatiotemporal differentiation, hazard factor analysis, Geo-LGBM}
}
